   "source": [
    "stock = int(input(\"Enter your stock quantity: \"))    # using to accept the input as an integer\n",
    "if stock == 0:\n",
    "    print(\"Out of stock\")\n",
    "elif (1<= stock <= 10):\n",
    "    print(\"Low stock\")\n",
    "else:\n",
    "    print(\"Well stocked\")"
   ]
